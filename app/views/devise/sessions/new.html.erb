<% content_for :page_title, "Login" %>

<div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 lg:p-10">
  <div class="space-y-2">
    <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Welcome back</p>
    <h2 class="text-xl font-semibold text-slate-100 sm:text-2xl">Sign in to Koto Pai</h2>
    <p class="text-sm text-slate-400">Track what you owe and what you’re owed.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-xs text-slate-400">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-700 bg-slate-950 text-emerald-400" %>
        Remember me
      </label>
    <% end %>

    <%= f.submit "Login", class: "w-full rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950" %>
  <% end %>

  <div class="mt-4 text-sm text-slate-400">
    <%= render "devise/shared/links" %>
  </div>
</div>
