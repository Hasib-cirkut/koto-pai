<% content_for :page_title, @chain.title.presence || "Chain" %>
<% content_for :breadcrumb, "Home / Chain" %>

<%= turbo_stream_from [@chain, current_user] %>

<div class="space-y-6">
  <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Details</p>
        <div class="mt-2" data-controller="inline-edit">
          <div data-inline-edit-target="display" class="flex items-center gap-2">
            <h2 class="text-lg font-semibold text-slate-100">
              <%= @chain.title.presence || "Untitled chain" %>
            </h2>
            <% if @chain.creator_id == current_user.id %>
              <button type="button" data-action="click->inline-edit#open" class="rounded-full border border-slate-700 bg-slate-900 px-2 py-1 text-xs text-slate-300 hover:border-slate-500">
                ✎
              </button>
            <% end %>
          </div>
          <% if @chain.creator_id == current_user.id %>
            <div data-inline-edit-target="form" class="hidden">
              <%= form_with model: @chain, url: chain_path(@chain), method: :patch, class: "mt-2 flex items-center gap-2" do |f| %>
                <%= f.text_field :title, class: "w-full rounded-2xl border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none", placeholder: "Chain title" %>
                <%= f.submit "Save", class: "rounded-full bg-emerald-400 px-3 py-2 text-xs font-semibold text-slate-950" %>
                <button type="button" data-action="click->inline-edit#close" class="rounded-full border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-semibold text-slate-300 hover:border-slate-500">
                  Cancel
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
        <p class="mt-2 text-sm text-slate-300"><%= @chain.description.presence || "No notes yet." %></p>
        <p class="mt-3 text-xs text-slate-500">
          Lender: <%= @chain.lender&.email || "Unassigned" %> • Borrower: <%= @chain.borrower&.email || "Unassigned" %>
        </p>
        <div class="mt-3 flex flex-wrap gap-2 text-[10px] uppercase tracking-[0.2em]">
          <% if (participant = @chain.chain_participants.find { |p| p.user_id == current_user.id }) %>
            <span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-slate-300"><%= participant.role %></span>
          <% else %>
            <span class="rounded-full border border-slate-800 bg-slate-900/60 px-3 py-1 text-slate-500">Not a participant</span>
          <% end %>
          <% if @chain.creator_id == current_user.id %>
            <span class="rounded-full border border-emerald-400/40 bg-emerald-400/10 px-3 py-1 text-emerald-200">Creator</span>
          <% end %>
        </div>
        <%= link_to "View full history", history_chain_path(@chain), class: "mt-3 inline-flex items-center gap-2 text-xs font-semibold text-emerald-300 hover:text-emerald-200" %>
        <% if @chain.creator_id == current_user.id %>
          <div class="mt-4" data-controller="modal">
            <button type="button" data-action="click->modal#open" class="rounded-full border border-rose-700/60 bg-rose-500/10 px-4 py-2 text-xs font-semibold text-rose-200 hover:border-rose-400">
              Delete chain
            </button>

            <dialog data-modal-target="dialog" class="modal-sheet rounded-3xl border border-slate-800 bg-slate-950 text-slate-100 shadow-2xl">
              <div class="p-6">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Confirm delete</p>
                <h2 class="mt-2 text-lg font-semibold">Delete this chain?</h2>
                <p class="mt-2 text-sm text-slate-400">This action cannot be undone.</p>

                <div class="mt-6 flex items-center justify-end gap-3">
                  <button type="button" data-action="click->modal#close" class="rounded-full border border-slate-700 bg-slate-900 px-4 py-2 text-xs font-semibold text-slate-300 hover:border-slate-500">
                    Cancel
                  </button>
                  <%= button_to "Delete", chain_path(@chain), method: :delete, class: "rounded-full border border-rose-700/60 bg-rose-500/10 px-4 py-2 text-xs font-semibold text-rose-200 hover:border-rose-400" %>
                </div>
              </div>
            </dialog>
          </div>
        <% end %>
      </div>
      <div class="text-right">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Outstanding</p>
        <div id="<%= dom_id(@chain, :outstanding) %>">
          <%= render "checkpoints/outstanding", chain: @chain %>
        </div>
        <p class="mt-1 text-xs text-slate-500"><%= @chain.status %></p>
      </div>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
    <div class="flex items-center justify-between">
      <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Participants</p>
      <p class="text-xs text-slate-500"><%= @chain.participants.count %> total</p>
    </div>
    <div id="<%= dom_id(@chain, :participants) %>" class="mt-4 space-y-2">
      <% @chain.chain_participants.includes(:user).each do |participant| %>
        <%= render "chain_participants/chain_participant", chain_participant: participant, chain: @chain %>
      <% end %>
    </div>

    <% current_participant = @chain.chain_participants.find { |p| p.user_id == current_user.id } %>
    <% if current_participant&.role.in?(%w[creator lender]) %>
      <%= form_with url: chain_chain_participants_path(@chain), class: "mt-4 grid gap-3" do %>
        <input type="email" name="participant_email" placeholder="Add by email" required class="w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" />
        <div class="flex gap-3">
          <select name="participant_role" class="w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none">
            <option value="viewer">Viewer</option>
            <option value="lender">Lender</option>
            <option value="borrower">Borrower</option>
          </select>
          <button type="submit" class="rounded-2xl bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-950">Add</button>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
    <div class="flex items-center justify-between">
      <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Checkpoints</p>
      <div id="<%= dom_id(@chain, :checkpoint_count) %>">
        <%= render "checkpoints/count", chain: @chain %>
      </div>
    </div>

    <% current_participant = @chain.chain_participants.find { |p| p.user_id == current_user.id } %>
    <% is_lender = @chain.lender_id == current_user.id %>
    <% is_borrower = @chain.borrower_id == current_user.id || current_participant&.role == "borrower" %>
    <% can_add_checkpoint = is_lender || is_borrower %>

    <% if can_add_checkpoint %>
      <%= form_with model: @checkpoint, url: chain_checkpoints_path(@chain), class: "mt-4 grid gap-3" do |f| %>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <%= f.label :amount, "Amount (BDT)", class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
            <%= f.number_field :amount, min: 1, class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" %>
          </div>
          <div>
            <%= f.label :note, class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
            <%= f.text_field :note, class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none", placeholder: "Payment received" %>
          </div>
        </div>
        <% if is_borrower && !is_lender %>
          <p class="text-xs text-amber-400">Your checkpoint will be submitted as a request for lender approval.</p>
        <% end %>
        <%= f.submit is_lender ? "Add Checkpoint" : "Request Checkpoint", class: "w-full rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950" %>
      <% end %>
    <% else %>
      <p class="mt-4 text-xs text-slate-500">Only the lender or borrower can add checkpoints.</p>
    <% end %>
    <%= render "checkpoints/list", chain: @chain %>
  </div>
</div>
