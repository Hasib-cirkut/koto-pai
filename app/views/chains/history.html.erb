<% content_for :page_title, "History" %>
<% content_for :breadcrumb, "Home / Chain / History" %>

<div class="space-y-4">
  <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
    <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Chain</p>
    <h2 class="mt-2 text-lg font-semibold"><%= @chain.title.presence || "Untitled chain" %></h2>
    <p class="mt-2 text-sm text-slate-400"><%= @chain.description.presence || "No notes yet." %></p>
  </div>

  <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
    <div class="flex items-center justify-between">
      <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Checkpoints</p>
      <p class="text-xs text-slate-500"><%= @checkpoints.size %> total</p>
    </div>

    <div class="mt-4 space-y-3">
      <% if @checkpoints.any? %>
        <% @checkpoints.each do |checkpoint| %>
          <div class="rounded-2xl border border-slate-800 bg-slate-950 px-4 py-3">
            <div class="flex items-center justify-between">
              <p class="text-sm font-semibold text-emerald-200"><%= number_to_currency(checkpoint.amount, unit: "৳", precision: 0) %></p>
              <p class="text-xs text-slate-500"><%= checkpoint.created_at.strftime("%b %d, %Y %H:%M") %></p>
            </div>
            <p class="mt-1 text-xs text-slate-500"><%= checkpoint.note.presence || "No note" %></p>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-slate-500">No checkpoints yet.</p>
      <% end %>
    </div>
  </div>
</div>
