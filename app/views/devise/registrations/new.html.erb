<% content_for :page_title, "Sign Up" %>

<div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 lg:p-10">
  <div class="space-y-2">
    <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Get started</p>
    <h2 class="text-xl font-semibold text-slate-100 sm:text-2xl">Create your account</h2>
    <p class="text-sm text-slate-400">You’ll need an email and password to continue.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-xs text-slate-500"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" %>
    </div>

    <%= f.submit "Sign up", class: "w-full rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950" %>
  <% end %>

  <div class="mt-4 text-sm text-slate-400">
    <%= render "devise/shared/links" %>
  </div>
</div>
