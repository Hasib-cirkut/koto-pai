<div class="flex w-full items-center justify-center">
  <div class="w-full max-w-5xl rounded-2xl flex justify-around items-center">

    <div class="w-sm h-sm text-gray-600">
      <%= raw File.read(Rails.root.join("app/assets/images/signin.svg")) %>
    </div>

    <!-- Right Side (Login Form Section) -->
    <div class="w-1/2 flex flex-col justify-center items-center p-10">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "w-full max-w-sm" }) do |f| %>
        <div class="form-control mb-4">
          <%= f.label :email, class: "label-text mb-1 font-medium" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-4">
          <%= f.label :password, class: "label-text mb-1 font-medium" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-control mb-4 flex items-center gap-2">
            <%= f.check_box :remember_me, class: "checkbox checkbox-sm" %>
            <%= f.label :remember_me, class: "label-text" %>
          </div>
        <% end %>

        <div class="form-control">
          <%= f.submit "Login", class: "btn btn-primary w-full" %>
        </div>
      <% end %>

      <div class="mt-4 text-sm">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
