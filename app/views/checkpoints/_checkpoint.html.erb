<div id="<%= dom_id(chain, checkpoint) %>" class="flex items-start justify-between gap-4 rounded-2xl border <%= checkpoint.pending? ? 'border-amber-500/30 bg-amber-500/5' : 'border-slate-800 bg-slate-950' %> px-4 py-3 text-sm">
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <p class="font-medium <%= checkpoint.pending? ? 'text-amber-200' : 'text-emerald-200' %>">
        <%= number_to_currency(checkpoint.amount, unit: "৳", precision: 0) %>
      </p>
      <% if checkpoint.pending? %>
        <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[10px] uppercase tracking-wider text-amber-300">Pending</span>
      <% elsif checkpoint.rejected? %>
        <span class="rounded-full border border-rose-500/30 bg-rose-500/10 px-2 py-0.5 text-[10px] uppercase tracking-wider text-rose-300">Rejected</span>
      <% end %>
    </div>
    <p class="text-xs text-slate-500"><%= checkpoint.note.presence || "No note" %></p>
    <p class="mt-1 text-[10px] text-slate-600">
      Requested by <%= checkpoint.created_by.email %>
      <% if checkpoint.approved_by %>
        • <%= checkpoint.approved? ? 'Approved' : 'Rejected' %> by <%= checkpoint.approved_by.email %>
      <% end %>
    </p>
  </div>
  <div class="flex flex-col items-end gap-2 shrink-0">
    <% if checkpoint.pending? && local_assigns[:can_manage] %>
      <div class="flex flex-col gap-1.5">
        <%= button_to "Approve", approve_chain_checkpoint_path(chain, checkpoint), method: :patch, class: "rounded-full bg-emerald-400/20 px-3 py-1 text-xs font-medium text-emerald-300 hover:bg-emerald-400/30 whitespace-nowrap" %>
        <%= button_to "Reject", reject_chain_checkpoint_path(chain, checkpoint), method: :patch, class: "rounded-full bg-rose-400/20 px-3 py-1 text-xs font-medium text-rose-300 hover:bg-rose-400/30 whitespace-nowrap" %>
      </div>
    <% end %>
    <p class="text-xs text-slate-500"><%= checkpoint.created_at.strftime("%b %d, %Y") %></p>
  </div>
</div>
