<%= link_to chain_path(chain), id: dom_id(chain, :card), class: "block rounded-3xl border border-slate-800 bg-slate-900/60 p-5 transition hover:border-slate-600" do %>
  <div class="flex items-start justify-between">
    <div>
      <p class="text-sm text-slate-400"><%= chain.currency %></p>
      <h2 class="text-lg font-semibold"><%= chain.title.presence || "Untitled chain" %></h2>
      <p class="mt-1 text-xs text-slate-500">
        Lender: <%= chain.lender&.email || "Unassigned" %> • Borrower: <%= chain.borrower&.email || "Unassigned" %>
      </p>
      <% latest_checkpoint = chain.checkpoints.order(created_at: :desc).first %>
      <p class="mt-2 text-xs text-slate-500">
        History: <%= latest_checkpoint&.note || chain.description.presence || "No history yet." %>
      </p>
    </div>
    <div class="text-right">
      <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Outstanding</p>
      <p class="text-lg font-semibold text-emerald-300">
        <%= number_to_currency(chain.outstanding, unit: "৳", precision: 0) %>
      </p>
      <p class="mt-1 text-xs text-slate-500"><%= chain.status %></p>
    </div>
  </div>
<% end %>
