<% content_for :page_title, "New Transaction" %>
<% content_for :breadcrumb, "Home / New" %>

<div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
  <%= form_with scope: :transaction, url: transactions_path, class: "space-y-5" do |f| %>
    <div>
      <%= f.label :title, class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
      <%= f.text_field :title, class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none", placeholder: "Rent for January" %>
    </div>

    <div>
      <%= f.label :description, "History / Notes", class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
      <%= f.text_area :description, rows: 3, class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none", placeholder: "Why this debt exists" %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :lent_money_cents, "Amount (in cents)", class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
        <%= f.number_field :lent_money_cents, min: 1, class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none", placeholder: "15000" %>
      </div>
      <div>
        <%= f.label :currency, class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
        <%= f.text_field :currency, value: @transaction.currency || "BDT", class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" %>
      </div>
    </div>

    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Your Role</p>
      <div class="mt-2 flex gap-3">
        <label class="flex items-center gap-2 rounded-full border border-slate-700 px-3 py-2 text-sm">
          <%= radio_button_tag :current_user_role, "lender", true %>
          I am the lender
        </label>
        <label class="flex items-center gap-2 rounded-full border border-slate-700 px-3 py-2 text-sm">
          <%= radio_button_tag :current_user_role, "borrower" %>
          I am the borrower
        </label>
      </div>
    </div>

    <div>
      <label class="text-xs uppercase tracking-[0.2em] text-slate-400">Counterparty Email (optional)</label>
      <input type="email" name="counterparty_email" class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" placeholder="friend@example.com" />
      <p class="mt-2 text-xs text-slate-500">Leave blank to add them later.</p>
    </div>

    <div class="flex items-center justify-between">
      <%= link_to "Back", transactions_path, class: "text-sm text-slate-400" %>
      <%= f.submit "Create Transaction", class: "rounded-full bg-emerald-400 px-5 py-2 text-sm font-semibold text-slate-950" %>
    </div>
  <% end %>
</div>
