<% content_for :page_title, @transaction.title.presence || "Transaction" %>
<% content_for :breadcrumb, "Home / Transaction" %>

<div class="space-y-6">
  <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Details</p>
        <p class="mt-2 text-sm text-slate-300"><%= @transaction.description.presence || "No notes yet." %></p>
        <p class="mt-3 text-xs text-slate-500">
          Lender: <%= @transaction.lender&.email || "Unassigned" %> • Borrower: <%= @transaction.borrower&.email || "Unassigned" %>
        </p>
        <%= link_to "View full history", history_transaction_path(@transaction), class: "mt-3 inline-flex items-center gap-2 text-xs font-semibold text-emerald-300 hover:text-emerald-200" %>
      </div>
      <div class="text-right">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Outstanding</p>
        <p class="mt-1 text-2xl font-semibold text-emerald-300">
          <%= number_to_currency(@transaction.outstanding, unit: "৳", precision: 0) %>
        </p>
        <p class="mt-1 text-xs text-slate-500"><%= @transaction.status %></p>
      </div>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
    <div class="flex items-center justify-between">
      <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Participants</p>
      <p class="text-xs text-slate-500"><%= @transaction.participants.count %> total</p>
    </div>
    <div class="mt-4 space-y-2">
      <% @transaction.chain_participants.includes(:user).each do |participant| %>
        <div class="flex items-center justify-between rounded-2xl border border-slate-800 bg-slate-950 px-4 py-2 text-sm">
          <span><%= participant.user.email %></span>
          <span class="text-xs uppercase tracking-[0.2em] text-slate-500"><%= participant.role %></span>
        </div>
      <% end %>
    </div>

    <%= form_with url: transaction_transaction_participants_path(@transaction), class: "mt-4 grid gap-3" do %>
      <input type="email" name="participant_email" placeholder="Add by email" required class="w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" />
      <div class="flex gap-3">
        <select name="participant_role" class="w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none">
          <option value="viewer">Viewer</option>
          <option value="lender">Lender</option>
          <option value="borrower">Borrower</option>
        </select>
        <button type="submit" class="rounded-2xl bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-950">Add</button>
      </div>
    <% end %>
  </div>

  <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
    <div class="flex items-center justify-between">
      <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Checkpoints</p>
      <p class="text-xs text-slate-500"><%= @transaction.checkpoints.count %> recorded</p>
    </div>
    <div class="mt-4 space-y-2">
      <% if @transaction.checkpoints.any? %>
        <% @transaction.checkpoints.order(created_at: :desc).each do |checkpoint| %>
          <div class="flex items-center justify-between rounded-2xl border border-slate-800 bg-slate-950 px-4 py-3 text-sm">
            <div>
            <p class="font-medium text-emerald-200"><%= number_to_currency(checkpoint.amount, unit: "৳", precision: 0) %></p>
              <p class="text-xs text-slate-500"><%= checkpoint.note.presence || "No note" %></p>
            </div>
            <p class="text-xs text-slate-500"><%= checkpoint.created_at.strftime("%b %d, %Y") %></p>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-slate-500">No checkpoints yet.</p>
      <% end %>
    </div>

    <% if @transaction.lender_id == current_user.id %>
      <%= form_with model: @checkpoint, url: transaction_checkpoints_path(@transaction), class: "mt-4 grid gap-3" do |f| %>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <%= f.label :amount, "Amount (BDT)", class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
            <%= f.number_field :amount, min: 1, class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" %>
          </div>
          <div>
            <%= f.label :note, class: "text-xs uppercase tracking-[0.2em] text-slate-400" %>
            <%= f.text_field :note, class: "mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none", placeholder: "Payment received" %>
          </div>
        </div>
        <%= f.submit "Add Checkpoint", class: "w-full rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950" %>
      <% end %>
    <% else %>
      <p class="mt-4 text-xs text-slate-500">Only the lender can add checkpoints.</p>
    <% end %>
  </div>
</div>
