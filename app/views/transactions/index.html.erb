<% content_for :page_title, "Your Ledger" %>
<% content_for :breadcrumb, "Home" %>

<%= turbo_stream_from "transactions_user_#{current_user.id}" %>

<div id="transactions_list" class="space-y-4">
  <% if @transactions.empty? %>
    <div id="transactions_empty" class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6 text-center">
      <p class="text-sm text-slate-300">No transactions yet.</p>
      <p class="mt-2 text-xs text-slate-500">Create one to start tracking what you owe or what you’re owed.</p>
    </div>
  <% else %>
    <% @transactions.each do |transaction| %>
      <%= turbo_stream_from transaction %>
      <%= render "transactions/card", transaction: transaction %>
    <% end %>
  <% end %>
</div>
