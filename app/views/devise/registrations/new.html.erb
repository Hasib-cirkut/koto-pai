<div class="flex w-full items-center justify-center">
  <div class="w-full max-w-5xl rounded-2xl flex justify-around items-center">

    <div class="w-1/2 flex flex-col justify-center items-center p-10">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-control mb-4">
          <%= f.label :email, class: "label-text mb-1 font-medium" %><br/>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-4">
          <%= f.label :password, class: "label-text mb-1 font-medium" %>
          <% if @minimum_password_length %>
            <em>(<%= @minimum_password_length %> characters minimum)</em>
          <% end %><br/>
          <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-4">
          <%= f.label :password_confirmation, class: "label-text mb-1 font-medium" %><br/>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= f.submit "Sign up", class: "btn btn-primary w-full" %>
        </div>
      <% end %>

      <div class="mt-4 text-sm">
        <%= render "devise/shared/links" %>
      </div>
    </div>

    <div class="w-sm h-sm text-gray-600">
      <%= raw File.read(Rails.root.join("app/assets/images/signup.svg")) %>
    </div>

  </div>
</div>
